{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cv",
  "type": "object",
  "required": ["meta", "person", "experience", "projects", "securityResearch", "skills", "documents"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "contentVersion", "lastUpdated", "siteUrl"],
      "properties": {
        "schemaVersion": { "type": "integer" },
        "contentVersion": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "siteUrl": { "type": "string", "format": "uri" }
      }
    },
    "person": { "type": "object" },
    "experience": { "type": "array", "minItems": 1 },
    "projects": { "type": "array", "minItems": 1 },
    "securityResearch": { "type": "object" },
    "skills": { "type": "array", "minItems": 1 },
    "documents": { "type": "object" }
  }
}
